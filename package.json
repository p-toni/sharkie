{
  "name": "sharkie-mascot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A tiny, expressive SVG shark mascot for the web.",
  "license": "MIT",
  "main": "./dist/sharkie.js",
  "module": "./dist/sharkie.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sharkie.js"
    }
  },
  "files": [
    "dist",
    "ATTRIBUTION.md",
    "vendor/bloub/LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
